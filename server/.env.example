# CareWave Backend Environment Configuration

PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
# Supported clients: 'postgres' or 'sqlite' (auto-detected if unset)
DB_CLIENT=sqlite
# For PostgreSQL:
# DATABASE_URL=postgresql://carewave:carewave123@localhost:5432/carewave
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=carewave

# For SQLite:
SQLITE_DB_PATH=./carewave.db

# Security & JWT
JWT_SECRET=carewave_super_secret_jwt_key_rural_telemed_2026!
JWT_EXPIRES_IN=7d
DISABLE_AUTH=false

# File Upload Configuration
UPLOAD_DIR=./uploads
CHUNK_DIR=./uploads/chunks
COMPLETED_DIR=./uploads/completed
MAX_CHUNK_SIZE_MB=10
DEFAULT_CHUNK_SIZE=1048576
UPLOAD_SESSION_TTL_HOURS=24

# CORS
CORS_ORIGIN=*

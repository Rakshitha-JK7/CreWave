  "description": "CareWave Telemedicine Backend - Reliable, offline-first, priority-driven consultation and chunked upload system for rural clinics",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
